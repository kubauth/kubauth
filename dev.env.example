# Kubauth local dev environment overrides.
#
# Copy this file to `dev.env` (git-ignored) and uncomment/edit what you want to
# change. It is sourced by the hack/ scripts (e.g. `make dev-up`), by the
# Makefile, and by the devcontainer shell — so it applies identically on the
# host and inside the devcontainer. Use simple, unquoted `KEY=value` lines only —
# no shell syntax (`export`, `$(...)`, quotes): the Makefile reads this file via
# `-include`, i.e. it is parsed as a makefile, not run by a shell.
#
# Every setting is OPTIONAL. With no dev.env file, the defaults below apply and
# the environment behaves exactly as if this file did not exist.

# Host port published for the local OCI registry (default: 5001). Change it if
# 5001 is already taken on your machine — e.g. another product's dev registry
# (KuboCD's default is also 5001). NOTE: if the registry is already running, run
# `make dev-down` before `make dev-up` for the new port to apply.
#KUBAUTH_REGISTRY_PORT=5001

# Kind cluster name (default: kubauth) and registry container name
# (default: kubauth-registry). Override only if they collide with another stack.
#KUBAUTH_CLUSTER_NAME=kubauth
#KUBAUTH_REGISTRY_NAME=kubauth-registry

# Image/chart registry for `make docker-build` / `docker-push` / `make chart-*`.
# Override to publish under your own namespace (default: quay.io/kubauth).
# NOTE: this overrides ONLY the registry — product versions stay git-controlled
# (they can't be changed from dev.env, only via the CLI, e.g. make APP_VERSION=…).
#REGISTRY=ghcr.io/your-user
